    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
