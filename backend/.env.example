# scripts/dev.py loads backend/.env; direct manage.py requires shell variables.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
# Requires PostGIS, GDAL and GEOS before enabling; draft profiling works without GIS.
DJANGO_ENABLE_GIS=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=bims
POSTGRES_USER=bims
POSTGRES_PASSWORD=replace-locally
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional absolute private filesystem path for resident photos.
# Default: repository .local/private-media (ignored by Git). Never serve publicly.
# PRIVATE_MEDIA_ROOT=C:/BIMS/private-media

# Optional Esri hybrid imagery + matching labels. Browser-visible, basemap-only
# ArcGIS credential; restrict allowed website origins. Never use an admin token.
# GIS_ESRI_BROWSER_KEY=

# Optional licensed XYZ source overrides; see docs/GIS.md. No keys are committed.
# Defaults: online OSM street tiles, coarse NASA satellite composite.
# GIS_SATELLITE_URL=https://your-licensed-provider.example/{z}/{x}/{y}.jpg
# GIS_SATELLITE_ATTRIBUTION=Your provider and imagery credits
# GIS_SATELLITE_LICENCE=https://your-licensed-provider.example/terms
# GIS_SATELLITE_MAX_NATIVE_ZOOM=18
# GIS_SATELLITE_OFFLINE=false
# For offline street tiles, provision licensed local files first:
# GIS_STREET_URL=/api/v1/gis/tiles/street/{z}/{x}/{y}.png
# GIS_STREET_ATTRIBUTION=Your licensed source credits
# GIS_STREET_LICENCE=https://your-provider.example/terms
# GIS_STREET_MAX_NATIVE_ZOOM=18
# GIS_STREET_OFFLINE=true
