# scripts/dev.py loads backend/.env; direct manage.py requires shell variables.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
# Requires PostGIS, GDAL and GEOS before enabling; draft profiling works without GIS.
DJANGO_ENABLE_GIS=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=bims
POSTGRES_USER=bims
POSTGRES_PASSWORD=replace-locally
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
